{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Astralform",
  "colors": {
    "primary": "#ffffff",
    "light": "#a1a1aa",
    "dark": "#18181b"
  },
  "modeToggle": {
    "default": "dark"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "iOS SDK",
            "pages": [
              "ios-sdk/installation",
              "ios-sdk/configuration",
              "ios-sdk/conversations",
              "ios-sdk/client-tools"
            ]
          },
          {
            "group": "Dashboard",
            "pages": [
              "dashboard/teams",
              "dashboard/projects",
              "dashboard/api-keys",
              "dashboard/rate-limits",
              "dashboard/agents",
              "dashboard/permissions",
              "dashboard/llm-providers",
              "dashboard/voice",
              "dashboard/mcp-servers",
              "dashboard/platform-tools",
              "dashboard/memory-providers",
              "dashboard/video-generation",
              "dashboard/connectors",
              "dashboard/github",
              "dashboard/telegram",
              "dashboard/skills"
            ]
          },
          {
            "group": "AstralChat",
            "pages": [
              "astralchat/overview"
            ]
          },
          {
            "group": "Enterprise",
            "pages": [
              "enterprise/organizations",
              "enterprise/sso",
              "enterprise/scim"
            ]
          },
          {
            "group": "Capsule",
            "pages": [
              "dashboard/capsule/pods",
              "dashboard/capsule/templates"
            ]
          },
          {
            "group": "Development",
            "pages": [
              "development/local-docker-stack"
            ]
          }
        ]
      },
      {
        "tab": "Claude Connector",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "plugin/connect"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "plugin/mcp-tools"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Chat",
            "pages": [
              "api-reference/chat/stream",
              "api-reference/chat/tool-result"
            ]
          },
          {
            "group": "Conversations",
            "pages": [
              "api-reference/conversations/list",
              "api-reference/conversations/messages",
              "api-reference/conversations/rename",
              "api-reference/conversations/delete"
            ]
          },
          {
            "group": "Voice",
            "pages": [
              "api-reference/voice/config",
              "api-reference/voice/transcriptions",
              "api-reference/voice/polish"
            ]
          },
          {
            "group": "Tools",
            "pages": [
              "api-reference/tools/list",
              "api-reference/tools/mcp"
            ]
          },
          {
            "group": "Skills",
            "pages": [
              "api-reference/skills/list",
              "api-reference/skills/commands"
            ]
          },
          {
            "group": "Agents",
            "pages": [
              "api-reference/agents/list"
            ]
          },
          {
            "group": "Status",
            "pages": [
              "api-reference/status/health",
              "api-reference/status/agent"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/astralform_logo.jpg",
    "dark": "/logo/astralform_logo.jpg"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/astralform-ai",
        "icon": "github"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://astralform.ai"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/astralform-ai"
    }
  },
  "seo": {
    "indexHiddenPages": false
  },
  "api": {
    "baseUrl": "https://api.astralform.ai",
    "auth": {
      "method": "bearer"
    },
    "playground": {
      "mode": "simple"
    }
  },
  "redirects": [
    {
      "source": "/api-reference/status/project",
      "destination": "/api-reference/status/agent"
    },
    {
      "source": "/plugin/installation",
      "destination": "/plugin/connect"
    },
    {
      "source": "/plugin/authentication",
      "destination": "/plugin/connect"
    },
    {
      "source": "/plugin/commands",
      "destination": "/plugin/connect"
    },
    {
      "source": "/api-reference/conversations/get",
      "destination": "/api-reference/conversations/messages"
    }
  ]
}
